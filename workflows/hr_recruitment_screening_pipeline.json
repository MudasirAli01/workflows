        "sendTo": "={{ $('Fetch Candidate Profiles').item.json.Email }}",
        "subject": "=Congratulations {{ $('Fetch Candidate Profiles').item.json['Candidate Name'] }}! 🎉\n\nYou are {{ $json.Result }} for the position. We’re excited to move forward with you!",
        "message": "=<!doctype html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Interview Booking</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#f4f6f8;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f4f6f8;padding:24px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 6px 18px rgba(0,0,0,0.06);\">\n          <tr>\n            <td style=\"padding:24px 28px;background:linear-gradient(90deg,#2a9df4,#1e73be);color:#ffffff;\">\n              <h1 style=\"margin:0;font-size:20px;font-weight:700;\">Congratulations!</h1>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:28px;\">\n              <p style=\"margin:0 0 16px 0;font-size:16px;color:#333333;\">\n                Hi <strong>{{ $('Fetch Candidate Profiles').item.json['Candidate Name'] }}</strong>,\n              </p>\n              <p style=\"margin:0 0 16px 0;font-size:16px;color:#333333;line-height:1.5;\">\n                We’re excited to inform you that you’ve <strong>passed</strong> the initial selection process!\n              </p>\n              <div style=\"margin:18px 0;padding:16px;border-radius:6px;background:#f0fbff;border:1px solid #e1f4ff;\">\n                <p style=\"margin:0;font-size:15px;color:#0b6fb6;\">\n                  <strong>Status:</strong> {{ $json.Result }}\n                </p>\n              </div>\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:16px 0;\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"https://calendly.com/your-team/interview\" style=\"display:inline-block;padding:14px 24px;border-radius:6px;background:#1e73be;color:#ffffff;text-decoration:none;font-weight:600;font-size:15px;\">\n                      📅 Book Your Interview\n                    </a>\n                  </td>\n                </tr>\n              </table>\n              <p style=\"margin:20px 0 0 0;font-size:14px;color:#6b6b6b;\">\n                Once booked, you’ll receive a confirmation email with the meeting link and details.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
