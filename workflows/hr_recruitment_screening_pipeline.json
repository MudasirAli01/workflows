        "jsCode": "// Extract the Base64 content from the HTTP response\nconst base64Content = $json.content;\n\n// Decode Base64 to binary\nconst binaryData = Buffer.from(base64Content, 'base64');\n\n// Use the prospect id from the previous node's data\nconst fileName = $('Fetch Candidate Profiles').first().json.id;\n\n// Return with proper binary metadata so Drive sees the name\nreturn [\n  {\n    json: {\n      ...$json,\n      processedFileName: fileName\n    },\n    binary: {\n      data: {\n        data: binaryData.toString('base64'),\n        mimeType: \"application/pdf\",\n        fileName: fileName\n      }\n    }\n  }\n];\n"
      },
